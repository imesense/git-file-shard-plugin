<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Project Sdk="ImeSense.WixToolset.Sdk">
    <PropertyGroup>
        <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
        <OutputName>GitFileShardPlugin.$(Platform)</OutputName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ImeSense.WixToolset.UI.wixext" Version="7.0.0" />
    </ItemGroup>
</Project>
