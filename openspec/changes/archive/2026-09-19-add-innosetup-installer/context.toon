task:
  id: add-innosetup-installer
  capability: innosetup-installer
  created: 2026-09-19
  status: archived (merged into openspec/specs/innosetup-installer/spec.md)
  goal: "Windows installer for git-file-shard built on Inno Setup 7: packaging the PyInstaller binary, optional task adding {app}\\bin to PATH with removal on uninstall"
  workflow: "OpenSpec (proposal + design + tasks + delta spec), files are maintained manually — openspec CLI is not available in the environment"

environment:
  os: windows
  cwd: git-file-shard-plugin repository root
  shell: "PowerShell (primary); python/npm/node are not in PATH, venv is created inside the project"

stack:
  installer: Inno Setup 7 (ISCC.exe)
  payload: dist/git-file-shard.exe (PyInstaller, Python 3.8+)
  pascal_script: "[Code] section in Setup.iss"
  locales: english + russian (Locales/Options.eng.isl, Locales/Options.rus.isl)

conventions[7]:
  "Setup.iss: 4-space indentation"
  "Pascal comment { ... } cannot contain Inno constants ({app} closes the comment)"
  "every custom task message — in BOTH locales (eng + rus)"
  "registry via HKA root: admin -> HKLM, otherwise HKCU"
  "doc comments for [Code] functions in { ... } style after the signature"
  "default branch is default, PR template includes a manual testing checklist"
  "local test = manual install/uninstall (PATH checkbox verified by the user)"

commands:
  build: ISCC.exe src/ImeSense.GitFileShardPlugin.Setup.Inno/Setup.iss -> bin/GitFileShardPlugin.exe
  compile_check: ISCC.exe --output=no src/ImeSense.GitFileShardPlugin.Setup.Inno/Setup.iss
  payload_build: pyinstaller git-file-shard.spec --noconfirm -> dist/git-file-shard.exe

inno_engine:
  registry:
    root: HKA
    subkey: System\CurrentControlSet\Control\Session Manager\Environment
    read: RegQueryStringValue (REG_SZ and REG_EXPAND_SZ)
    write: RegWriteExpandStringValue (preserves %SystemRoot% and the like)
  messages:
    SendMessageTimeout is NOT registered in the engine
    SendNotifyMessage is unreliable for WM_SETTINGCHANGE (the lParam string may be freed before it is read)
    solution: external 'SendMessageTimeoutW@user32.dll stdcall'
    parameters: HWND_BROADCAST, WM_SETTINGCHANGE=$001A, SMTO_ABORTIFHUNG=$0002, timeout 5000
    available in the engine[6]: SendMessage, PostMessage, SendNotifyMessage, SendBroadcastMessage, PostBroadcastMessage, SendBroadcastNotifyMessage
  events[2]{event,step,purpose}:
    CurStepChanged,ssPostInstall,"UpdatePath(True) when the task is selected + RefreshEnvironment"
    CurUninstallStepChanged,usUninstall,"UpdatePath(False), while the application directory still exists"
  path_logic:
    split: "StringSplit(Path, [PathSeparator], stExcludeEmpty)"
    dedup: SameText + AddBackslash (case-insensitive, slash normalization)
    idempotency: write only if the new value <> the old one
  task: "addtopath without Flags: unchecked -> enabled by default; check via WizardIsTaskSelected('addtopath')"

gotchas[3]:
  ISCC --output=no still deletes the old output file from OutputDir -> a rebuild is needed after the check
  "the short option /O- does not work ('You may not specify more than one script filename'); the working order is options AFTER the script filename"
  "the {app} constant inside a { } comment terminates the comment"

references:
  spec: openspec/specs/innosetup-installer/spec.md
  delta: openspec/changes/add-innosetup-installer/specs/innosetup-installer/spec.md
  artifacts: openspec/changes/add-innosetup-installer/ (proposal, design, tasks)
  script: src/ImeSense.GitFileShardPlugin.Setup.Inno/Setup.iss
  locales: src/ImeSense.GitFileShardPlugin.Setup.Inno/Locales/
  commits: 3a20e98 -> b881a55 -> 6909e5b
