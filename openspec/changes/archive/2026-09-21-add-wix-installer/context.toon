task:
  id: add-wix-installer
  capability: wix-installer
  created: 2026-09-21
  status: archived (merged into openspec/specs/wix-installer/spec.md)
  goal: "MSI installer for git-file-shard built on WiX Toolset 7: packaging the PyInstaller binary, custom options dialog with a checkbox for adding bin to PATH via the MSI Environment table"
  workflow: "OpenSpec (proposal + design + tasks + delta spec), files are maintained manually — openspec CLI is not available in the environment"

environment:
  os: windows
  cwd: git-file-shard-plugin repository root
  shell: "bash (Git Bash) for the agent; dotnet is installed but NOT in the bash PATH"
  dotnet: "dotnet SDK (8/9/10) is available outside the bash PATH — invoke it by its full installation path"

stack:
  installer: WiX Toolset 7 (WixToolset.Sdk/7.0.0, NuGet)
  ui_ext: WixToolset.UI.wixext/7.0.0 (NuGet PackageReference in .wixproj)
  payload: dist/git-file-shard.exe (PyInstaller, Python 3.8+)
  ui_set: WixUI_InstallDir (via <ui:WixUI InstallDirectory="INSTALLFOLDER" />)
  locales: english + russian (Package.en-us.wxl, Package.ru-ru.wxl, Codepage=1251)
  sources: "local clone of the WiX sources (see wix_sources): wixlib with dialogs — src/ext/UI/wixlib"

conventions[6]:
  "wixproj: PackageReference to WixToolset.UI.wixext, OutputName=GitFileShardPlugin"
  "WiX v4+ authoring: <Package> instead of <Product>, schema http://wixtoolset.org/schemas/v4/wxs"
  "every user-facing string — in BOTH locales (en-us + ru-ru)"
  "MSI is built via dotnet build .wixproj (no need to look for wix.exe separately)"
  "the payload must exist before the build: dist/git-file-shard.exe, otherwise WIX0103"
  "default branch is default; local test = manual install/uninstall"

commands:
  build: dotnet build src/ImeSense.GitFileShardPlugin.Setup.Wix/ImeSense.GitFileShardPlugin.Setup.Wix.wixproj -> bin/GitFileShardPlugin.msi
  payload_build: pyinstaller git-file-shard.spec --noconfirm -> dist/git-file-shard.exe

msi_engine:
  path:
    approach: "MSI Environment table instead of manual code (unlike Inno Setup)"
    component: "Component Id=AddToPath Directory=INSTALLBIN Guid=F1CAFAE6-4997-4D72-A17B-9B5E8A45ADA3 Condition=ADDTOPATH"
    entry: "Environment Id=PathEntry Name=PATH Value=[INSTALLBIN] Part=last Action=set System=yes"
    idempotency: "guaranteed by MSI itself: append on install, remove on uninstall"
    property: "ADDTOPATH Secure=yes Value=1 (checkbox enabled by default; Secure is required to survive elevation)"
  ui_sequence:
    builtin: "WixUI_InstallDir: WelcomeDlg -> LicenseAgreementDlg -> InstallDirDlg -> VerifyReadyDlg"
    custom: "OptionsDlg inserted between InstallDirDlg and VerifyReadyDlg (only when NOT Installed)"
    checkbox: "Control Type=CheckBox Property=ADDTOPATH CheckBoxValue=1 — direct binding to the property, no custom actions needed"

gotchas[4]:
  "MAIN GOTCHA: the built-in WixUI_InstallDir publishes an UNCONDITIONAL NewDialog->VerifyReadyDlg with Order=4 on InstallDirDlg/Next; MSI executes ControlEvents in ascending Order, and when several NewDialog events exist the LAST one wins -> the custom transition must have Order=5, otherwise OptionsDlg silently never opens (while WiX still builds without errors!)"
  "VerifyReadyDlg/Back: the built-in transition -> InstallDirDlg has Order=1 -> the custom transition to OptionsDlg must be Order=2"
  "Equal Order values on the same control = nondeterministic winner, do not rely on it"
  "dotnet is not in the bash environment PATH: invoke it by its full installation path"

debug_story:
  symptom: "the OptionsDlg page was not displayed, the PATH option was visually unavailable"
  research: "the WiX sources (src/ext/UI/wixlib/WixUI_InstallDir.wxs) showed a built-in Publish InstallDirDlg/Next NewDialog VerifyReadyDlg Order=4 without a Condition"
  root_cause: "the custom Publish to OptionsDlg had Order=2 < 4, the built-in transition overrode it (last NewDialog wins)"
  fix: "Order=5 for InstallDirDlg/Next->OptionsDlg, Order=2 for VerifyReadyDlg/Back->OptionsDlg; redundant Publish entries for the Installed branch removed (the built-ins already cover them)"
  verification: "dotnet build without WiX errors (only WIX0103 for the missing payload before the PyInstaller build); manual installation confirmed by the user: the dialog is visible, PATH is set"

references:
  delta: openspec/changes/add-wix-installer/specs/wix-installer/spec.md
  artifacts: openspec/changes/add-wix-installer/ (proposal, design, tasks)
  project: src/ImeSense.GitFileShardPlugin.Setup.Wix/
  wix_sources: "local clone of the WiX Toolset sources (repository github.com/wixtoolset/wix): src/ext/UI/wixlib — the dialog reference, UICompiler.cs — WixUI_Id_<arch> resolution"
  related: openspec/specs/innosetup-installer/spec.md (EXE installer, parallel delivery)
